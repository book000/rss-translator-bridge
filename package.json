{
  "name": "rss-translator-bridge",
  "version": "1.0.0",
  "description": "RSS Feed translation bridge server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "tsx ./src/index.ts",
    "dev": "tsx watch ./src/index.ts",
    "build": "tsc",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc",
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:tsc": "tsc --noEmit",
    "fix": "run-z fix:prettier,fix:eslint",
    "fix:prettier": "prettier --write .",
    "fix:eslint": "eslint --fix .",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rss",
    "translator",
    "bridge",
    "fastify"
  ],
  "author": "book000",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/static": "^7.0.4",
    "fastify": "^4.25.0",
    "rss-parser": "3.13.0",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.9.15",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.34",
    "@types/xml2js": "0.4.14",
    "eslint": "9.30.0",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "run-z": "2.1.0",
    "ts-jest": "29.4.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
